{
    # HTTP -> HTTPS リダイレクト機能を無効化します
    auto_https disable_redirects

    # SNI（ホスト名指定）がないアクセスが来たら、強制的にこのIPアドレスの設定（証明書）を使いなさい、という指示
    default_sni {{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }}
}

# バックエンド（Wiki.js）へのリバースプロキシ設定
https://{{ domain_name }} {
    {% if caddy_use_internal_certs | default(false) %}
    tls internal
    {% endif %}
    reverse_proxy wikijs:3000 {
        # Replica調整で複数へ負荷分散した場合に Session Stickyにしてセッションを維持する
        lb_policy cookie {{ domain_name }}_session 12h
    }
}

https://{{ hostvars[inventory_hostname]['ansible_default_ipv4']['address'] }} {
    {% if caddy_use_internal_certs | default(false) %}
    tls internal
    {% endif %}
    reverse_proxy wikijs:3000 {
        # Replica調整で複数へ負荷分散した場合に Session Stickyにしてセッションを維持する
        lb_policy cookie {{ domain_name }}_session 12h
    }
}